{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "keyward": "Host=localhost;Port=5432;Database=keyward;Username=keyward;Password=keyward"
  },
  "Keyward": {
    "Tokens": {
      "AccessTokenLifetime": "00:05:00",
      "IdentityTokenLifetime": "00:05:00",
      "AuthorizationCodeLifetime": "00:02:00",
      "RefreshTokenLifetime": "14.00:00:00",
      "RefreshFamilyAbsoluteLifetime": "30.00:00:00"
    },
    "Mfa": {
      "Issuer": "Keyward",
      "VerificationWindowSteps": 1,
      "LockoutThreshold": 5,
      "BackupCodeCount": 10,
      "RequiredForRoles": [ "admin" ]
    },
    "Database": {
      "MigrateOnStartup": false
    },
    "Seed": {
      "Enabled": false
    }
  }
}
